export struct EqBandView {
    frequency: int,
    gain: float,
    q: float,
    filter: int,
    plot-x: float,
    plot-y: float,
}

// Neutral graphite palette with a single accent. Colour is reserved for state:
// accent = selected/active, red = muted/destructive, green = connected, amber = warning.
global Theme {
    out property <color> bg: #121316;
    out property <color> sidebar: #0d0e10;
    out property <color> panel: #191a1e;
    out property <color> inset: #131417;
    out property <color> control: #23252a;
    out property <color> hover: #2c2e35;
    out property <color> line: #26282d;
    out property <color> line-strong: #363840;
    out property <color> text: #ececef;
    out property <color> text-2: #a4a6ae;
    out property <color> text-3: #6f717a;
    out property <color> accent: #8b7cf8;
    out property <color> accent-hover: #9a8dfa;
    out property <color> accent-dim: #8b7cf822;
    out property <color> red: #e5484d;
    out property <color> green: #3dd68c;
    out property <color> amber: #f5a524;
    out property <string> display: "Segoe UI Variable Display";
    out property <length> radius: 10px;
}

// The one tooltip of the window. Hover sources fill it in; AppWindow draws it on top.
global Tip {
    in-out property <string> text;
    // Anchor: horizontal centre, top edge and height of the hovered element, in window coordinates.
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> anchor-height;
}

global Icons {
    out property <string> mic: "M12 3 A3 3 0 0 1 15 6 L15 12 A3 3 0 0 1 9 12 L9 6 A3 3 0 0 1 12 3 Z M5 11 A7 7 0 0 0 19 11 M12 18 L12 21";
    out property <string> mic-off: "M12 3 A3 3 0 0 1 15 6 L15 12 A3 3 0 0 1 9 12 L9 6 A3 3 0 0 1 12 3 Z M5 11 A7 7 0 0 0 19 11 M12 18 L12 21 M3 3 L21 21";
    out property <string> mixer: "M6 4 L6 20 M12 4 L12 20 M18 4 L18 20 M4 15 L8 15 M10 8 L14 8 M16 12 L20 12";
    out property <string> eq: "M3 15 C6 15 7 7 10 7 C13 7 13 17 16 17 C19 17 19 11 21 11";
    out property <string> sun: "M8.5 12 A3.5 3.5 0 1 0 15.5 12 A3.5 3.5 0 1 0 8.5 12 Z M12 3 L12 5 M12 19 L12 21 M3 12 L5 12 M19 12 L21 12 M5.6 5.6 L7 7 M17 17 L18.4 18.4 M5.6 18.4 L7 17 M17 7 L18.4 5.6";
    out property <string> gear: "M 18.97 9.84 L 21.36 10.39 L 21.36 13.61 L 18.97 14.16 L 18.46 15.41 L 19.76 17.48 L 17.48 19.76 L 15.41 18.46 L 14.16 18.97 L 13.61 21.36 L 10.39 21.36 L 9.84 18.97 L 8.59 18.46 L 6.52 19.76 L 4.24 17.48 L 5.54 15.41 L 5.03 14.16 L 2.64 13.61 L 2.64 10.39 L 5.03 9.84 L 5.54 8.59 L 4.24 6.52 L 6.52 4.24 L 8.59 5.54 L 9.84 5.03 L 10.39 2.64 L 13.61 2.64 L 14.16 5.03 L 15.41 5.54 L 17.48 4.24 L 19.76 6.52 L 18.46 8.59 Z M 9 12 A 3 3 0 1 0 15 12 A 3 3 0 1 0 9 12 Z";
    out property <string> sidebar-collapse: "M4 5 L20 5 L20 19 L4 19 Z M9 5 L9 19 M15.5 9.5 L13 12 L15.5 14.5";
    out property <string> sidebar-expand: "M4 5 L20 5 L20 19 L4 19 Z M9 5 L9 19 M13 9.5 L15.5 12 L13 14.5";
    out property <string> lock: "M6 11 L18 11 L18 20 L6 20 Z M8.5 11 L8.5 8 A3.5 3.5 0 0 1 15.5 8 L15.5 11";
    out property <string> unlock: "M6 11 L18 11 L18 20 L6 20 Z M8.5 11 L8.5 8 A3.5 3.5 0 0 1 15.2 6.5";
    out property <string> plus: "M12 6 L12 18 M6 12 L18 12";
    out property <string> trash: "M5 7 L19 7 M10 7 L10 4.5 L14 4.5 L14 7 M7 7 L8 19.5 L16 19.5 L17 7";
    out property <string> import: "M12 4 L12 15 M8 11 L12 15 L16 11 M5 19 L19 19";
    out property <string> export: "M12 15 L12 4 M8 8 L12 4 L16 8 M5 19 L19 19";
    out property <string> alert: "M12 8 L12 13 M12 16 L12 16.5 M3.5 12 A8.5 8.5 0 1 0 20.5 12 A8.5 8.5 0 1 0 3.5 12 Z";
    out property <string> info: "M12 11 L12 16.5 M12 7.5 L12 8 M3.5 12 A8.5 8.5 0 1 0 20.5 12 A8.5 8.5 0 1 0 3.5 12 Z";
    out property <string> close: "M7 7 L17 17 M17 7 L7 17";
    out property <string> check: "M6 12.5 L10 16.5 L18 8";
    out property <string> chevron: "M7 10 L12 15 L17 10";
}

component Icon inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke-width: 1.6px;
    fill: transparent;
}

// Shows `text` as a tooltip after the pointer rests on the parent element.
component TipSource inherits Rectangle {
    in property <string> text;
    in property <bool> hovered;
    Timer {
        interval: 450ms;
        running: root.hovered && root.text != "";
        triggered => {
            Tip.x = root.absolute-position.x + root.width / 2;
            Tip.y = root.absolute-position.y;
            Tip.anchor-height = root.height;
            Tip.text = root.text;
        }
    }
    changed hovered => {
        if !root.hovered {
            Tip.text = "";
        }
    }
}

// Small "i" mark: the explanation lives in its tooltip instead of on the page.
component Hint inherits Rectangle {
    in property <string> text;
    width: 16px;
    Icon {
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        stroke-width: 1.5px;
        commands: Icons.info;
        stroke: ta.has-hover ? Theme.text-2 : Theme.text-3;
    }
    ta := TouchArea { }
    TipSource { text: root.text; hovered: ta.has-hover; }
}

component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
}

component SectionLabel inherits Text {
    color: Theme.text-3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : #3a3c44;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 120ms; }
    Rectangle {
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component CheckBox inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    height: 24px;
    width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 16px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: root.checked ? Theme.accent : transparent;
                border-width: root.checked ? 0 : 1px;
                border-color: ta.has-hover ? Theme.text-2 : Theme.text-3;
                animate background { duration: 100ms; }
                if root.checked : Icon { x: 1px; y: 1px; width: 14px; height: 14px; stroke-width: 2px; commands: Icons.check; stroke: #ffffff; }
            }
        }
        Text { text: root.text; color: ta.has-hover ? Theme.text : Theme.text-2; font-size: 13px; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <string> tip: "";
    // "default" | "primary" | "danger"
    in property <string> kind: "default";
    in property <bool> enabled: true;
    callback clicked;
    property <color> fg: root.kind == "primary" ? #ffffff : root.kind == "danger" ? Theme.red : Theme.text;
    property <bool> hot: ta.has-hover && root.enabled;
    height: 32px;
    border-radius: 6px;
    background: root.kind == "primary" ? (root.hot ? Theme.accent-hover : Theme.accent)
        : root.kind == "danger" ? (root.hot ? #e5484d1f : transparent)
        : (root.hot ? Theme.hover : Theme.control);
    border-width: 1px;
    border-color: root.kind == "primary" ? transparent : root.kind == "danger" ? #e5484d66 : Theme.line-strong;
    opacity: !root.enabled ? 0.4 : ta.pressed ? 0.8 : 1;
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.icon != "" : Rectangle {
            width: 16px;
            Icon { y: (parent.height - self.height) / 2; width: 16px; height: 16px; commands: root.icon; stroke: root.fg; }
        }
        if root.text != "" : Text { text: root.text; color: root.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipSource { text: root.tip; hovered: ta.has-hover; }
}

component Segmented inherits Rectangle {
    in property <[string]> items;
    in property <int> index;
    in property <bool> enabled: true;
    callback selected(int);
    property <length> seg-w: (self.width - 4px) / root.items.length;
    height: 32px;
    border-radius: 6px;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.line-strong;
    opacity: root.enabled ? 1 : 0.4;
    Rectangle {
        x: 2px + root.index * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: parent.height - 4px;
        border-radius: 4px;
        background: #3d3f49;
        animate x { duration: 140ms; easing: ease-out; }
    }
    for item[i] in root.items : Rectangle {
        x: 2px + i * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: parent.height - 4px;
        Text {
            width: parent.width;
            height: parent.height;
            text: item;
            color: i == root.index || seg-ta.has-hover ? Theme.text : Theme.text-2;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

// Option button used for voice effects, light patterns and animations.
component Choice inherits Rectangle {
    in property <string> text;
    in property <string> tip: "";
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: root.selected ? Theme.accent-dim : ta.has-hover && root.enabled ? Theme.hover : Theme.control;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.line-strong;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 100ms; }
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-2;
        font-size: 13px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipSource { text: root.tip; hovered: ta.has-hover; }
}

component ChoiceGrid inherits Rectangle {
    in property <[string]> items;
    in property <[string]> tips;
    in property <int> columns;
    in property <int> selected-index;
    in property <bool> enabled: true;
    callback picked(int);
    property <length> gap: 8px;
    property <length> cell-w: (self.width - (root.columns - 1) * root.gap) / root.columns;
    property <int> rows: Math.ceil(root.items.length / root.columns);
    height: root.rows * 36px + (root.rows - 1) * root.gap;
    for item[i] in root.items : Choice {
        x: Math.mod(i, root.columns) * (root.cell-w + root.gap);
        y: Math.floor(i / root.columns) * (36px + root.gap);
        width: root.cell-w;
        text: item;
        tip: i < root.tips.length ? root.tips[i] : "";
        selected: i == root.selected-index;
        enabled: root.enabled;
        clicked => { root.picked(i); }
    }
}

// Drop-down list.
component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    // Open above the control (for controls near the bottom of the window).
    in property <bool> drop-up: false;
    callback selected(int);
    property <length> row-h: 30px;
    property <length> list-h: Math.min(root.model.length * root.row-h, 300px) + 8px;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover && root.enabled ? Theme.hover : Theme.control;
    border-width: 1px;
    border-color: Theme.line-strong;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 100ms; }
    Text {
        x: 10px;
        width: parent.width - 38px;
        height: parent.height;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "—";
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        commands: Icons.chevron;
        stroke: Theme.text-2;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.drop-up ? -root.list-h - 4px : root.height + 4px;
        width: root.width;
        height: root.list-h;
        Rectangle {
            background: #202126;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000080;
            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.model.length * root.row-h;
                for item[i] in root.model : Rectangle {
                    y: i * root.row-h;
                    width: root.width - 8px;
                    height: root.row-h;
                    border-radius: 4px;
                    background: item-ta.has-hover ? Theme.hover : i == root.current-index ? Theme.accent-dim : transparent;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: item;
                        color: i == root.current-index || item-ta.has-hover ? Theme.text : Theme.text-2;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// Single-line text field. `accepted` fires on Enter and when a changed field loses focus.
component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback accepted(string);
    callback edited(string);
    property <bool> dirty: false;
    height: 32px;
    border-radius: 6px;
    background: Theme.inset;
    border-width: 1px;
    border-color: input.has-focus && root.enabled ? Theme.accent : Theme.line-strong;
    opacity: root.enabled ? 1 : 0.4;
    clip: true;
    if input.text == "" : Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-3;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        enabled: root.enabled;
        single-line: true;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 13px;
        selection-background-color: #8b7cf880;
        selection-foreground-color: #ffffff;
        edited => {
            root.dirty = true;
            root.edited(self.text);
        }
        accepted => {
            root.dirty = false;
            root.accepted(self.text);
        }
        changed has-focus => {
            if !self.has-focus && root.dirty {
                root.dirty = false;
                root.accepted(self.text);
            }
        }
    }
}

// Setting row: title (with an optional hint) on the left, a control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> tip: "";
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 8px;
    Text { height: 32px; text: root.title; color: Theme.text; font-size: 13px; vertical-alignment: center; }
    if root.tip != "" : Hint { text: root.tip; }
    Rectangle { horizontal-stretch: 1; }
    @children
}

// Labelled row of the lighting controls.
component Labeled inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    Text { width: 96px; text: root.label; color: Theme.text-2; font-size: 13px; vertical-alignment: center; }
    @children
}

// Horizontal slider over a colour track (hue, saturation, brightness).
component ColorSlider inherits Rectangle {
    in property <float> value;
    in property <brush> track;
    in property <color> knob-color;
    in property <bool> enabled: true;
    callback moved(float);
    height: 20px;
    opacity: root.enabled ? 1 : 0.4;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 10px;
        border-radius: 5px;
        background: root.track;
        border-width: 1px;
        border-color: #ffffff14;
    }
    Rectangle {
        x: Math.clamp(root.value, 0, 1) * (parent.width - self.width);
        y: 1px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.knob-color;
        border-width: 2px;
        border-color: #ffffff;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.moved(Math.clamp((self.mouse-x - 9px) / (self.width - 18px), 0, 1));
            }
        }
        moved => {
            if self.pressed {
                root.moved(Math.clamp((self.mouse-x - 9px) / (self.width - 18px), 0, 1));
            }
        }
    }
}

// Palette plus hue / saturation / brightness sliders.
component ColorPicker inherits VerticalLayout {
    in-out property <float> hue;
    in-out property <float> sat;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed();
    property <color> current: hsv(root.hue, root.sat, root.value);
    spacing: 14px;
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for c in [
            { h: 0.0, s: 0.0 }, { h: 0.0, s: 0.85 }, { h: 25.0, s: 0.9 }, { h: 50.0, s: 0.9 },
            { h: 120.0, s: 0.8 }, { h: 185.0, s: 0.85 }, { h: 220.0, s: 0.85 }, { h: 265.0, s: 0.7 },
            { h: 300.0, s: 0.75 }, { h: 330.0, s: 0.7 }
        ] : Rectangle {
            property <bool> current: Math.abs(root.hue - c.h) < 0.5 && Math.abs(root.sat - c.s) < 0.01;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: hsv(c.h, c.s, 1);
            border-width: self.current ? 2px : 1px;
            border-color: self.current ? #ffffff : #00000040;
            opacity: root.enabled ? 1 : 0.4;
            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.hue = c.h;
                    root.sat = c.s;
                    root.value = 1;
                    root.changed();
                }
            }
        }
    }
    Labeled {
        label: @tr("Hue");
        ColorSlider {
            horizontal-stretch: 1;
            value: root.hue / 360;
            knob-color: hsv(root.hue, 1, 1);
            track: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.6%, #00ff00 33.3%, #00ffff 50%, #0000ff 66.6%, #ff00ff 83.3%, #ff0000 100%);
            enabled: root.enabled;
            moved(v) => {
                root.hue = v * 360;
                if (root.sat < 0.05) {
                    root.sat = 0.8;
                }
                root.changed();
            }
        }
        Text { width: 44px; text: Math.round(root.hue) + "°"; color: Theme.text-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
    }
    Labeled {
        label: @tr("Saturation");
        ColorSlider {
            horizontal-stretch: 1;
            value: root.sat;
            knob-color: root.current;
            track: @linear-gradient(90deg, #ffffff 0%, hsv(root.hue, 1, 1) 100%);
            enabled: root.enabled;
            moved(v) => {
                root.sat = v;
                root.changed();
            }
        }
        Text { width: 44px; text: Math.round(root.sat * 100) + "%"; color: Theme.text-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
    }
    Labeled {
        label: @tr("Brightness");
        ColorSlider {
            horizontal-stretch: 1;
            value: root.value;
            knob-color: root.current;
            track: @linear-gradient(90deg, #000000 0%, hsv(root.hue, root.sat, 1) 100%);
            enabled: root.enabled;
            moved(v) => {
                root.value = v;
                root.changed();
            }
        }
        Text { width: 44px; text: Math.round(root.value * 100) + "%"; color: Theme.text-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
    }
}

// Plain slider with an accent fill.
component Slider inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    callback moved(float);
    height: 20px;
    opacity: root.enabled ? 1 : 0.4;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: #2e3036;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 8px + Math.clamp(root.value, 0, 1) * (parent.width - 16px);
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: Math.clamp(root.value, 0, 1) * (parent.width - self.width);
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: ta.pressed ? #ffffff : #d7d8dd;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.moved(Math.clamp((self.mouse-x - 8px) / (self.width - 16px), 0, 1));
            }
        }
        moved => {
            if self.pressed {
                root.moved(Math.clamp((self.mouse-x - 8px) / (self.width - 16px), 0, 1));
            }
        }
    }
}

// The LED ring as the microphone shows it. LED 0 is on the left and the order runs
// clockwise, matching the layout Genie uses for the AM8 Pro.
component LedRing inherits Rectangle {
    in property <[color]> colors;
    in property <bool> lit: true;
    in property <bool> paintable;
    callback painted(int);
    width: 184px;
    height: 184px;
    border-radius: 92px;
    background: #0b0c0e;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        width: 88px;
        height: 88px;
        border-radius: 44px;
        background: Theme.inset;
        border-width: 1px;
        border-color: Theme.line;
    }
    for c[i] in root.colors : Rectangle {
        property <angle> a: i * 360deg / Math.max(root.colors.length, 1) + 180deg;
        width: 24px;
        height: 24px;
        x: (parent.width - self.width) / 2 + 68px * Math.cos(self.a);
        y: (parent.height - self.height) / 2 + 68px * Math.sin(self.a);
        border-radius: 12px;
        background: c;
        opacity: root.lit ? 1 : 0.3;
        border-width: dot-ta.has-hover && root.paintable ? 2px : 1px;
        border-color: dot-ta.has-hover && root.paintable ? #ffffff : #ffffff1a;
        dot-ta := TouchArea {
            enabled: root.paintable;
            mouse-cursor: root.paintable ? MouseCursor.pointer : MouseCursor.default;
            clicked => { root.painted(i); }
        }
    }
}

// Horizontal LED-style level meter (0–1 maps to -60…0 dBFS).
component LevelMeter inherits Rectangle {
    in property <float> level;
    in property <bool> active;
    property <int> segments: 32;
    height: 10px;
    for i in root.segments : Rectangle {
        property <float> pos: i / root.segments;
        x: i * parent.width / root.segments;
        width: parent.width / root.segments - 2px;
        height: parent.height;
        border-radius: 1px;
        background: root.active && root.level > self.pos
            ? (self.pos < 0.8 ? Theme.green : self.pos < 0.9 ? Theme.amber : Theme.red)
            : #2a2c31;
    }
}

// Vertical channel fader with a 0–100 % scale.
component Fader inherits Rectangle {
    in property <string> label;
    in property <float> maximum: 100;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(int);
    property <length> track-top: 64px;
    property <length> track-h: self.height - self.track-top - 8px;
    property <length> thumb-h: 16px;
    property <float> ratio: Math.clamp(root.value / root.maximum, 0, 1);
    opacity: root.enabled ? 1 : 0.4;

    function apply(py: length) {
        let r = Math.clamp(1 - (py - root.track-top - root.thumb-h / 2) / (root.track-h - root.thumb-h), 0, 1);
        let v = Math.round(r * root.maximum);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }

    function step(delta: int) {
        let v = Math.clamp(Math.round(root.value) + delta, 0, root.maximum);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }

    SectionLabel {
        y: 0;
        height: 14px;
        width: parent.width;
        horizontal-alignment: center;
        text: root.label;
    }
    Text {
        y: 22px;
        height: 30px;
        width: parent.width;
        horizontal-alignment: center;
        text: Math.round(root.ratio * 100) + "%";
        color: Theme.text;
        font-size: 22px;
        font-weight: 600;
        font-family: Theme.display;
    }
    // Scale
    for i in 5 : Text {
        x: parent.width / 2 - 44px;
        width: 24px;
        y: root.track-top + root.thumb-h / 2 + i * (root.track-h - root.thumb-h) / 4 - 7px;
        height: 14px;
        text: 100 - i * 25;
        color: Theme.text-3;
        font-size: 10px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    for i in 5 : Rectangle {
        x: parent.width / 2 - 16px;
        y: root.track-top + root.thumb-h / 2 + i * (root.track-h - root.thumb-h) / 4;
        width: 6px;
        height: 1px;
        background: Theme.line-strong;
    }
    // Track and fill
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.track-top;
        width: 4px;
        height: root.track-h;
        border-radius: 2px;
        background: #2e3036;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 4px;
        y: root.track-top + (1 - root.ratio) * (root.track-h - root.thumb-h) + root.thumb-h / 2;
        height: root.track-top + root.track-h - self.y;
        border-radius: 2px;
        background: Theme.accent;
    }
    // Thumb
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.track-top + (1 - root.ratio) * (root.track-h - root.thumb-h);
        width: 30px;
        height: root.thumb-h;
        border-radius: 4px;
        background: ta.pressed ? #ffffff : ta.has-hover ? #f0f0f3 : #d7d8dd;
        Rectangle { x: 6px; y: (parent.height - 1px) / 2; width: parent.width - 12px; height: 1px; background: #00000059; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.apply(self.mouse-y);
            }
        }
        moved => {
            if self.pressed {
                root.apply(self.mouse-y);
            }
        }
        scroll-event(event) => {
            if event.delta-y > 0 {
                root.step(1);
            } else if event.delta-y < 0 {
                root.step(-1);
            }
            accept
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <bool> collapsed;
    callback clicked;
    height: 36px;
    border-radius: 6px;
    background: root.active ? #22242a : ta.has-hover ? #1a1b1f : transparent;
    animate background { duration: 100ms; }
    Rectangle {
        x: 0;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        border-radius: 1px;
        background: root.active ? Theme.accent : transparent;
    }
    Icon {
        x: 9px;
        y: (parent.height - self.height) / 2;
        commands: root.icon;
        stroke: root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.text-2;
    }
    if !root.collapsed : Text {
        x: 38px;
        height: parent.height;
        text: root.text;
        color: root.active || ta.has-hover ? Theme.text : Theme.text-2;
        font-size: 13px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    TipSource { text: root.collapsed ? root.text : ""; hovered: ta.has-hover; }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    spacing: 12px;
    Text {
        horizontal-stretch: 1;
        height: 32px;
        text: root.title;
        color: Theme.text;
        font-size: 22px;
        font-weight: 600;
        font-family: Theme.display;
        vertical-alignment: center;
    }
    @children
}

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    Text { text: root.label; color: Theme.text-3; font-size: 12px; }
    @children
}

component Dialog inherits Rectangle {
    in property <length> dialog-width: 400px;
    // Escape or a click outside the card.
    callback dismissed;
    background: #000000a6;
    TouchArea { clicked => { root.dismissed(); } }
    scope := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismissed();
                return accept;
            }
            return reject;
        }
    }
    init => { scope.focus(); }
    Rectangle {
        width: root.dialog-width;
        height: content.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: #1d1e23;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;
        TouchArea { }
        content := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "FIFINE Lite";
    icon: @image-url("images/app-icon.png");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 960px;
    min-height: 660px;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";

    in-out property <int> page: 0;
    in property <string> app-version;

    // The microphone being controlled and what it can do.
    in property <string> device-name;
    in property <[string]> device-names: [];
    in-out property <int> device-index: 0;
    // Support for this model has not been checked on real hardware.
    in property <bool> experimental: false;
    in property <bool> has-image: false;
    in property <bool> has-light-switch: false;
    in property <bool> has-custom-light: false;
    in property <int> pattern-count: 0;
    in property <bool> has-mute: false;
    in property <int> noise-levels: 0;
    in property <bool> has-voice: false;
    in property <bool> has-input: false;
    in property <bool> has-headphone: false;
    in property <bool> has-mix: false;
    in property <bool> has-pickup: false;
    in property <bool> has-low-cut: false;
    in property <bool> has-mid-boost: false;
    in property <bool> has-eq: false;
    in property <bool> has-reset: false;
    in property <float> volume-max: 27;
    in property <float> mix-max: 24;
    property <bool> has-faders: root.has-input || root.has-headphone || root.has-mix;
    property <bool> has-lighting: root.has-custom-light || root.pattern-count > 0;
    callback device-selected(int);
    // Shown only while the microphone is not answering.
    in property <string> device-status;
    in-out property <bool> device-ready: false;
    in-out property <bool> light-on: false;
    // 0 is off; microphones with several strengths go up to `noise-levels`.
    in-out property <int> noise-level: 0;
    in-out property <int> pickup-index: 0;
    in-out property <bool> low-cut: false;
    in-out property <bool> mid-boost: false;
    in-out property <bool> mic-muted: false;
    in-out property <int> light-pattern-index: 0;
    in-out property <int> voice-index: 0;
    in-out property <float> input-volume: 0;
    in-out property <float> headphone-volume: 0;
    in-out property <float> monitor-mix: 0;
    in-out property <bool> confirm-reset: false;
    in-out property <string> error-message: "";
    callback setting-changed(string, int);
    callback reset-confirmed();
    callback mute-state-changed(bool);
    changed mic-muted => { root.mute-state-changed(root.mic-muted); }
    changed page => { Tip.text = ""; }

    // Equalizer
    in-out property <[EqBandView]> eq-bands: [];
    in-out property <[string]> eq-preset-names: ["Device Default"];
    in-out property <int> eq-channel-index: 1;
    in-out property <int> eq-preset-index: 0;
    in-out property <int> eq-selected-band: -1;
    in-out property <bool> eq-locked: true;
    in-out property <bool> eq-ready: false;
    in-out property <string> eq-curve: "M 0 200 L 1000 200";
    in-out property <string> selected-frequency: "";
    in-out property <string> selected-q: "";
    in-out property <string> selected-gain: "";
    in-out property <int> selected-filter: -1;
    property <bool> band-editable: root.device-ready && !root.eq-locked && root.eq-selected-band >= 0;
    callback eq-channel-changed(int);
    callback eq-preset-changed(int);
    callback eq-lock-changed(bool);
    callback eq-field-changed(string, string);
    callback eq-filter-changed(int);
    callback eq-add-band();
    callback eq-remove-band();
    callback eq-reset();
    callback eq-import();
    callback eq-export();
    callback eq-plot-pressed(float, float);
    callback eq-plot-moved(float, float);

    // App settings
    in-out property <bool> autostart: false;
    in-out property <int> close-action: 0;
    in-out property <bool> close-prompt: false;
    in-out property <bool> close-remember: false;
    in-out property <bool> sidebar-collapsed: false;
    // 0 follows Windows, 1 English, 2 Russian.
    in-out property <int> language-index: 0;
    callback language-changed(int);
    property <length> sidebar-width: root.sidebar-collapsed ? 56px : 204px;
    callback autostart-toggled(bool);
    callback close-action-changed(int);
    callback close-choice(bool /* to tray */, bool /* remember */);
    callback sidebar-toggled(bool);

    // Lighting: 0 built-in effect, 1 custom colour, 2 animation
    in-out property <int> light-mode: 0;
    in-out property <bool> per-led: false;
    // Colours of the ring diagram, filled in by the app.
    in property <[color]> ring-colors: [];
    in-out property <int> anim-index: 0;
    in-out property <float> anim-speed: 1;
    in-out property <float> second-hue: 190;
    in-out property <float> custom-hue: 260;
    in-out property <float> custom-sat: 0.65;
    in-out property <float> custom-value: 1;
    in-out property <[string]> effect-names: [];
    // The user's own names; empty where an effect has none.
    in property <[string]> effect-custom-names: [];
    // Text of the effect name field; empty while the effect has no name of its own.
    property <string> effect-name-draft;
    property <color> second-color: hsv(root.second-hue, 0.85, 1);
    property <bool> light-usable: root.device-ready && root.light-on;
    callback light-config-changed();
    callback led-painted(int);
    callback led-fill-all();
    callback effect-name-edited(int, string);
    function sync-effect-draft() {
        root.effect-name-draft = root.effect-custom-names[root.light-pattern-index];
    }
    changed light-pattern-index => { root.sync-effect-draft(); }

    // Microphone level meter
    in-out property <float> mic-level: 0;
    in-out property <float> mic-level-db: -60;
    in-out property <bool> level-active: false;

    HorizontalLayout {
        // ───────── Sidebar ─────────
        Rectangle {
            width: root.sidebar-width;
            animate width { duration: 140ms; easing: ease-out; }
            background: Theme.sidebar;
            clip: true;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Rectangle {
                    height: 36px;
                    if !root.sidebar-collapsed : Text {
                        x: 10px;
                        height: parent.height;
                        text: root.device-name;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 700;
                        font-family: Theme.display;
                        vertical-alignment: center;
                    }
                    if !root.sidebar-collapsed && root.experimental : Rectangle {
                        x: parent.width - 36px - self.width - 4px;
                        y: (parent.height - self.height) / 2;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: #f5a52422;
                        Text { text: "β"; color: Theme.amber; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        beta-ta := TouchArea { }
                        TipSource { text: @tr("Support for this model is based on fifine Genie data and has not been tested on the microphone itself."); hovered: beta-ta.has-hover; }
                    }
                    Rectangle {
                        x: parent.width - self.width;
                        width: 36px;
                        height: 36px;
                        border-radius: 6px;
                        background: toggle-ta.has-hover ? #1a1b1f : transparent;
                        Icon {
                            x: 9px;
                            y: 9px;
                            commands: root.sidebar-collapsed ? Icons.sidebar-expand : Icons.sidebar-collapse;
                            stroke: toggle-ta.has-hover ? Theme.text : Theme.text-3;
                        }
                        toggle-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.sidebar-collapsed = !root.sidebar-collapsed;
                                root.sidebar-toggled(root.sidebar-collapsed);
                            }
                        }
                        TipSource { text: root.sidebar-collapsed ? @tr("Expand sidebar") : @tr("Collapse sidebar"); hovered: toggle-ta.has-hover; }
                    }
                }
                if !root.sidebar-collapsed && root.device-names.length > 1 : Select {
                    model: root.device-names;
                    current-index <=> root.device-index;
                    selected(i) => { root.device-selected(i); }
                }
                Rectangle { height: 8px; }
                NavItem { text: @tr("Mixer"); icon: Icons.mixer; collapsed: root.sidebar-collapsed; active: root.page == 0; clicked => { root.page = 0; } }
                if root.has-eq : NavItem { text: @tr("Equalizer"); icon: Icons.eq; collapsed: root.sidebar-collapsed; active: root.page == 1; clicked => { root.page = 1; } }
                if root.has-lighting : NavItem { text: @tr("Lighting"); icon: Icons.sun; collapsed: root.sidebar-collapsed; active: root.page == 2; clicked => { root.page = 2; } }
                Rectangle { }
                NavItem { text: @tr("Settings"); icon: Icons.gear; collapsed: root.sidebar-collapsed; active: root.page == 3; clicked => { root.page = 3; } }
                Rectangle { height: 6px; }
                Divider { }
                // Connection status; only the dot remains when collapsed.
                Rectangle {
                    height: 36px;
                    Rectangle {
                        x: 14px;
                        y: (parent.height - self.height) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.device-ready ? Theme.green : Theme.amber;
                    }
                    if !root.sidebar-collapsed : Text {
                        x: 38px;
                        height: parent.height;
                        text: root.device-ready ? @tr("Connected") : @tr("Not connected");
                        color: Theme.text-2;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ───────── Content ─────────
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 24px;
            padding-top: 20px;
            spacing: 16px;

            if !root.device-ready : Rectangle {
                border-radius: 8px;
                background: #f5a52414;
                border-width: 1px;
                border-color: #f5a52455;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 18px;
                        Icon { y: (parent.height - self.height) / 2; commands: Icons.alert; stroke: Theme.amber; }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.device-status;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }

            // ═════════ Mixer ═════════
            if root.page == 0 : VerticalLayout {
                spacing: 16px;
                PageHeader { title: @tr("Mixer"); }

                HorizontalLayout {
                    spacing: 16px;
                    vertical-stretch: 1;

                    // Microphone panel
                    Panel {
                        min-width: 288px;
                        max-width: root.has-faders ? 288px : 100000px;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 140px;
                                border-radius: 8px;
                                background: Theme.inset;
                                if !root.has-image : Text {
                                    text: "fifine " + root.device-name;
                                    color: Theme.text-3;
                                    font-size: 20px;
                                    font-weight: 600;
                                    font-family: Theme.display;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if root.has-image : Image {
                                    x: (parent.width - self.width) / 2;
                                    y: 8px;
                                    width: parent.width - 32px;
                                    height: parent.height - 16px;
                                    source: @image-url("images/genie/am8pro.png");
                                    image-fit: contain;
                                    opacity: root.device-ready ? 1 : 0.35;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                vertical-stretch: 0;
                                alignment: start;
                                HorizontalLayout {
                                    Text { text: @tr("Voice level"); color: Theme.text-2; font-size: 12px; horizontal-stretch: 1; }
                                    Text {
                                        text: !root.level-active ? "—" : root.mic-level-db <= -59.5 ? @tr("−∞ dB") : @tr("{} dB", Math.round(root.mic-level-db));
                                        color: root.mic-level-db > -6 && root.level-active ? Theme.red : Theme.text-3;
                                        font-size: 12px;
                                    }
                                }
                                LevelMeter { level: root.mic-level; active: root.level-active; }
                            }
                            // Mute
                            if root.has-mute : Rectangle {
                                height: 44px;
                                border-radius: 8px;
                                background: root.mic-muted ? (mute-ta.has-hover ? #e5484d33 : #e5484d26) : (mute-ta.has-hover ? Theme.hover : Theme.control);
                                border-width: 1px;
                                border-color: root.mic-muted ? Theme.red : Theme.line-strong;
                                opacity: root.device-ready ? 1 : 0.4;
                                animate background { duration: 100ms; }
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    Rectangle {
                                        width: 20px;
                                        Icon {
                                            y: (parent.height - self.height) / 2;
                                            width: 20px;
                                            height: 20px;
                                            commands: root.mic-muted ? Icons.mic-off : Icons.mic;
                                            stroke: root.mic-muted ? Theme.red : Theme.text;
                                        }
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.mic-muted ? @tr("Microphone muted") : @tr("Microphone on");
                                        color: root.mic-muted ? #ff8f93 : Theme.text;
                                        font-size: 14px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                                mute-ta := TouchArea {
                                    enabled: root.device-ready;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.mic-muted = !root.mic-muted;
                                        root.setting-changed("mic-mute", root.mic-muted ? 1 : 0);
                                    }
                                }
                            }
                            if root.noise-levels == 1 : SettingRow {
                                padding-top: 0;
                                padding-bottom: 0;
                                title: @tr("Noise suppression");
                                VerticalLayout {
                                    alignment: center;
                                    Switch {
                                        checked: root.noise-level > 0;
                                        enabled: root.device-ready;
                                        toggled(on) => {
                                            root.noise-level = on ? 1 : 0;
                                            root.setting-changed("noise", root.noise-level);
                                        }
                                    }
                                }
                            }
                            if root.noise-levels > 1 : VerticalLayout {
                                vertical-stretch: 0;
                                alignment: start;
                                spacing: 6px;
                                Text { text: @tr("Noise suppression"); color: Theme.text; font-size: 13px; }
                                Segmented {
                                    items: [@tr("Off"), @tr("Low"), @tr("Medium"), @tr("High")];
                                    index: root.noise-level;
                                    enabled: root.device-ready;
                                    selected(i) => {
                                        root.noise-level = i;
                                        root.setting-changed("noise", i);
                                    }
                                }
                            }
                            if root.has-low-cut : SettingRow {
                                padding-top: 0;
                                padding-bottom: 0;
                                title: @tr("Low cut");
                                VerticalLayout {
                                    alignment: center;
                                    Switch {
                                        checked <=> root.low-cut;
                                        enabled: root.device-ready;
                                        toggled(on) => { root.setting-changed("low-cut", on ? 1 : 0); }
                                    }
                                }
                            }
                            if root.has-mid-boost : SettingRow {
                                padding-top: 0;
                                padding-bottom: 0;
                                title: @tr("Mid boost");
                                VerticalLayout {
                                    alignment: center;
                                    Switch {
                                        checked <=> root.mid-boost;
                                        enabled: root.device-ready;
                                        toggled(on) => { root.setting-changed("mid-boost", on ? 1 : 0); }
                                    }
                                }
                            }
                        }
                    }

                    // Levels
                    if root.has-faders : Panel {
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            padding: 16px;
                            if root.has-input : Fader {
                                horizontal-stretch: 1;
                                label: @tr("MICROPHONE");
                                maximum: root.volume-max;
                                value <=> root.input-volume;
                                enabled: root.device-ready;
                                changed(v) => { root.setting-changed("input-volume", v); }
                            }
                            if root.has-input && root.has-headphone : Rectangle { width: 1px; background: Theme.line; }
                            if root.has-headphone : Fader {
                                horizontal-stretch: 1;
                                label: @tr("HEADPHONES");
                                maximum: root.volume-max;
                                value <=> root.headphone-volume;
                                enabled: root.device-ready;
                                changed(v) => { root.setting-changed("headphone-volume", v); }
                            }
                            if root.has-mix && (root.has-input || root.has-headphone) : Rectangle { width: 1px; background: Theme.line; }
                            if root.has-mix : Fader {
                                horizontal-stretch: 1;
                                label: @tr("MONITORING");
                                maximum: root.mix-max;
                                value <=> root.monitor-mix;
                                enabled: root.device-ready;
                                changed(v) => { root.setting-changed("monitor-mix", v); }
                            }
                        }
                    }
                }

                if root.has-pickup : Panel {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionLabel { text: @tr("PICKUP PATTERN"); }
                        ChoiceGrid {
                            columns: 4;
                            items: [@tr("Cardioid"), @tr("Bidirectional"), @tr("Stereo"), @tr("Omnidirectional")];
                            selected-index: root.pickup-index;
                            enabled: root.device-ready;
                            picked(i) => {
                                root.pickup-index = i;
                                root.setting-changed("pickup", i + 1);
                            }
                        }
                    }
                }

                // Voice effect
                if root.has-voice : Panel {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        SectionLabel { text: @tr("VOICE EFFECT"); }
                        ChoiceGrid {
                            columns: 8;
                            items: [@tr("None"), @tr("Old man"), @tr("Monster"), @tr("Robot"), @tr("Megaphone"), @tr("Child"), @tr("Female"), @tr("Male")];
                            selected-index: root.voice-index;
                            enabled: root.device-ready;
                            picked(i) => {
                                root.voice-index = i;
                                root.setting-changed("voice-changer", i == 0 ? 0 : i + 1);
                            }
                        }
                    }
                }
            }

            // ═════════ Equalizer ═════════
            if root.page == 1 : VerticalLayout {
                spacing: 16px;
                PageHeader {
                    title: @tr("Equalizer");
                    Hint { text: @tr("Microphone: how others hear your voice.\nHeadphones: only what you hear."); }
                    // Microphone first; channel index 1 is the microphone on the device.
                    Segmented {
                        width: 240px;
                        items: [@tr("Microphone"), @tr("Headphones")];
                        index: 1 - root.eq-channel-index;
                        enabled: root.device-ready;
                        selected(i) => { root.eq-channel-changed(1 - i); }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Select {
                        width: 200px;
                        model: root.eq-preset-names;
                        current-index <=> root.eq-preset-index;
                        enabled: root.eq-ready;
                        selected(i) => { root.eq-preset-changed(i); }
                    }
                    Button {
                        text: root.eq-locked ? @tr("Locked") : @tr("Editing");
                        icon: root.eq-locked ? Icons.lock : Icons.unlock;
                        kind: root.eq-locked ? "default" : "primary";
                        tip: @tr("The lock protects the curve from accidental edits and closes again after 5 minutes.");
                        clicked => { root.eq-lock-changed(!root.eq-locked); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Import"); icon: Icons.import; enabled: root.eq-ready && !root.eq-locked; clicked => { root.eq-import(); } }
                    Button { text: @tr("Export"); icon: Icons.export; enabled: root.eq-ready; clicked => { root.eq-export(); } }
                    Button { text: @tr("Reset"); kind: "danger"; enabled: root.eq-ready; tip: @tr("Restore the curve of the selected preset."); clicked => { root.eq-reset(); } }
                }

                Panel {
                    vertical-stretch: 1;
                    min-height: 260px;
                    Rectangle {
                        x: 16px;
                        y: 16px;
                        width: parent.width - 32px;
                        height: parent.height - 32px;

                        for db in [12, 6, 0, -6, -12] : Text {
                            x: 0;
                            width: 30px;
                            y: Math.clamp((12 - db) / 24 * plot.height - 7px, 0, plot.height - 14px);
                            height: 14px;
                            text: (db > 0 ? "+" : "") + db;
                            color: Theme.text-3;
                            font-size: 10px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        for f in [
                            { r: 0.0, t: "20" }, { r: 0.2330, t: "100" }, { r: 0.3333, t: "200" }, { r: 0.4660, t: "500" },
                            { r: 0.5663, t: "1k" }, { r: 0.6667, t: "2k" }, { r: 0.7993, t: "5k" }, { r: 0.8997, t: "10k" }, { r: 1.0, t: "20k" }
                        ] : Text {
                            x: plot.x + Math.clamp(f.r * plot.width - 20px, -4px, plot.width - 36px);
                            y: plot.y + plot.height + 6px;
                            width: 40px;
                            text: f.t;
                            color: Theme.text-3;
                            font-size: 10px;
                            horizontal-alignment: center;
                        }

                        plot := Rectangle {
                            x: 40px;
                            width: parent.width - 40px;
                            height: parent.height - 22px;
                            background: Theme.inset;
                            border-radius: 6px;

                            for g in [
                                { r: 0.1327, major: false }, { r: 0.2330, major: true }, { r: 0.3333, major: false }, { r: 0.4660, major: false },
                                { r: 0.5663, major: true }, { r: 0.6667, major: false }, { r: 0.7993, major: false }, { r: 0.8997, major: true }
                            ] : Rectangle {
                                x: g.r * parent.width;
                                width: 1px;
                                height: parent.height;
                                background: g.major ? #ffffff12 : #ffffff08;
                            }
                            for db in [6, 0, -6] : Rectangle {
                                y: (12 - db) / 24 * parent.height;
                                height: 1px;
                                width: parent.width;
                                background: db == 0 ? #ffffff26 : #ffffff08;
                            }

                            TouchArea {
                                enabled: root.eq-ready;
                                mouse-cursor: root.eq-locked ? MouseCursor.default : MouseCursor.crosshair;
                                pointer-event(event) => {
                                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        root.eq-plot-pressed(self.mouse-x / self.width, self.mouse-y / self.height);
                                    }
                                }
                                moved => {
                                    if self.pressed && !root.eq-locked {
                                        root.eq-plot-moved(self.mouse-x / self.width, self.mouse-y / self.height);
                                    }
                                }
                            }

                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 1000;
                                viewbox-height: 400;
                                fit: fill;
                                commands: root.eq-curve + " L 1000 200 L 0 200 Z";
                                fill: #8b7cf81c;
                            }
                            Path {
                                width: parent.width;
                                height: parent.height;
                                viewbox-width: 1000;
                                viewbox-height: 400;
                                fit: fill;
                                commands: root.eq-curve;
                                stroke: Theme.accent;
                                stroke-width: 2px;
                            }

                            for band[i] in root.eq-bands : handle := Rectangle {
                                property <bool> sel: i == root.eq-selected-band;
                                width: 18px;
                                height: 18px;
                                x: band.plot-x * plot.width - 9px;
                                y: band.plot-y * plot.height - 9px;
                                border-radius: 9px;
                                background: handle.sel ? #ffffff : #26272d;
                                border-width: 2px;
                                border-color: Theme.accent;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: i + 1;
                                    color: handle.sel ? #26272d : Theme.text;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                Panel {
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            width: 56px;
                            alignment: center;
                            spacing: 2px;
                            SectionLabel { text: @tr("POINT"); }
                            Text {
                                text: root.eq-selected-band >= 0 ? @tr("No. {}", root.eq-selected-band + 1) : "—";
                                color: Theme.text;
                                font-size: 18px;
                                font-weight: 600;
                            }
                        }
                        Field {
                            label: @tr("Frequency, Hz");
                            TextField { width: 110px; text <=> root.selected-frequency; placeholder: "20–20000"; enabled: root.band-editable; accepted(value) => { root.eq-field-changed("frequency", value); } }
                        }
                        Field {
                            label: @tr("Q factor");
                            TextField { width: 96px; text <=> root.selected-q; placeholder: "0.5–10"; enabled: root.band-editable; accepted(value) => { root.eq-field-changed("q", value); } }
                        }
                        Field {
                            label: @tr("Gain, dB");
                            TextField { width: 96px; text <=> root.selected-gain; placeholder: "±12"; enabled: root.band-editable; accepted(value) => { root.eq-field-changed("gain", value); } }
                        }
                        Field {
                            label: @tr("Filter type");
                            Select {
                                width: 160px;
                                drop-up: true;
                                model: [@tr("Bell"), @tr("Low shelf"), @tr("High shelf"), @tr("High-pass"), @tr("Low-pass"), @tr("Notch")];
                                current-index <=> root.selected-filter;
                                enabled: root.band-editable;
                                selected(i) => { root.eq-filter-changed(i); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: end;
                            HorizontalLayout {
                                spacing: 8px;
                                Button { text: @tr("Point"); icon: Icons.plus; enabled: root.eq-ready && !root.eq-locked; clicked => { root.eq-add-band(); } }
                                Button { icon: Icons.trash; text: @tr("Delete"); enabled: root.eq-ready && !root.eq-locked && root.eq-selected-band >= 0; clicked => { root.eq-remove-band(); } }
                            }
                        }
                    }
                }
            }

            // ═════════ Lighting ═════════
            if root.page == 2 : VerticalLayout {
                spacing: 16px;
                alignment: start;
                PageHeader {
                    title: @tr("Lighting");
                    if root.has-light-switch : VerticalLayout {
                        alignment: center;
                        Switch {
                            checked <=> root.light-on;
                            enabled: root.device-ready;
                            toggled(on) => { root.setting-changed("light-switch", on ? 1 : 0); }
                        }
                    }
                }
                Panel {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 8px;
                            Segmented {
                                width: 330px;
                                items: [root.pattern-count > 0 ? @tr("Effects") : @tr("Built-in"), @tr("Colour"), @tr("Animations")];
                                index: root.light-mode;
                                enabled: root.light-usable && root.has-custom-light;
                                selected(i) => {
                                    root.light-mode = i;
                                    root.light-config-changed();
                                }
                            }
                            Hint { text: @tr("Effects are built into the microphone.\nCustom colours and animations come from the computer: keep the app running, it can sit in the tray."); }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        if root.light-mode == 0 && root.pattern-count == 0 : Text {
                            text: @tr("This model switches its built-in effects with the button on the microphone.");
                            color: Theme.text-3;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        // Built-in effects
                        if root.light-mode == 0 && root.pattern-count > 0 : VerticalLayout {
                            spacing: 12px;
                            ChoiceGrid {
                                columns: 5;
                                items: root.effect-names;
                                selected-index: root.light-pattern-index;
                                enabled: root.light-usable;
                                picked(i) => {
                                    root.light-pattern-index = i;
                                    root.setting-changed("light-pattern", i + 1);
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                TextField {
                                    width: 260px;
                                    text <=> root.effect-name-draft;
                                    placeholder: @tr("Name of effect {}", root.light-pattern-index + 1);
                                    init => { root.sync-effect-draft(); }
                                    edited(value) => { root.effect-name-edited(root.light-pattern-index, value); }
                                }
                                Hint { text: @tr("Built-in effects have no names.\nTurn one on, look at the ring and label it."); }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        // Custom colour and animations
                        if root.light-mode != 0 : HorizontalLayout {
                            spacing: 28px;
                            VerticalLayout {
                                alignment: start;
                                LedRing {
                                    colors: root.ring-colors;
                                    lit: root.light-usable;
                                    paintable: root.light-mode == 1 && root.per-led && root.light-usable;
                                    painted(i) => { root.led-painted(i); }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 14px;
                                alignment: start;

                                if root.light-mode == 1 : HorizontalLayout {
                                    spacing: 8px;
                                    Segmented {
                                        width: 280px;
                                        items: [@tr("One colour"), @tr("Per LED")];
                                        index: root.per-led ? 1 : 0;
                                        enabled: root.light-usable;
                                        selected(i) => {
                                            root.per-led = i == 1;
                                            root.light-config-changed();
                                        }
                                    }
                                    if root.per-led : Hint { text: @tr("Pick a colour and click the dots of the ring."); }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.per-led : Button {
                                        text: @tr("Fill all");
                                        enabled: root.light-usable;
                                        clicked => { root.led-fill-all(); }
                                    }
                                }

                                if root.light-mode == 2 : ChoiceGrid {
                                    columns: 4;
                                    items: [@tr("Breathing"), @tr("Rainbow"), @tr("Gradient"), @tr("Voice")];
                                    tips: [
                                        @tr("The ring slowly fades in and out."),
                                        @tr("The whole spectrum runs around the ring."),
                                        @tr("Two colours flow into each other around the ring."),
                                        @tr("The louder you speak, the more LEDs light up.\nWindows shows the microphone as in use meanwhile.")
                                    ];
                                    selected-index: root.anim-index;
                                    enabled: root.light-usable;
                                    picked(i) => {
                                        root.anim-index = i;
                                        root.light-config-changed();
                                    }
                                }
                                if root.light-mode == 2 && root.anim-index != 3 : Labeled {
                                    label: @tr("Speed");
                                    Slider {
                                        horizontal-stretch: 1;
                                        value: (root.anim-speed - 0.2) / 2.8;
                                        enabled: root.light-usable;
                                        moved(v) => {
                                            root.anim-speed = 0.2 + v * 2.8;
                                            root.light-config-changed();
                                        }
                                    }
                                    Text { width: 44px; text: "×" + Math.round(root.anim-speed * 10) / 10; color: Theme.text-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                }

                                // Rainbow uses no colour of its own.
                                if !(root.light-mode == 2 && root.anim-index == 1) : ColorPicker {
                                    hue <=> root.custom-hue;
                                    sat <=> root.custom-sat;
                                    value <=> root.custom-value;
                                    enabled: root.light-usable;
                                    changed => { root.light-config-changed(); }
                                }
                                if root.light-mode == 2 && root.anim-index == 2 : Labeled {
                                    label: @tr("Second colour");
                                    ColorSlider {
                                        horizontal-stretch: 1;
                                        value: root.second-hue / 360;
                                        knob-color: root.second-color;
                                        track: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.6%, #00ff00 33.3%, #00ffff 50%, #0000ff 66.6%, #ff00ff 83.3%, #ff0000 100%);
                                        enabled: root.light-usable;
                                        moved(v) => {
                                            root.second-hue = v * 360;
                                            root.light-config-changed();
                                        }
                                    }
                                    Text { width: 44px; text: Math.round(root.second-hue) + "°"; color: Theme.text-3; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }

            // ═════════ Settings ═════════
            if root.page == 3 : VerticalLayout {
                spacing: 16px;
                PageHeader { title: @tr("Settings"); }
                Panel {
                    VerticalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        SettingRow {
                            title: @tr("Start with Windows");
                            tip: @tr("The app starts minimized to the tray.");
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked <=> root.autostart;
                                    toggled(on) => { root.autostart-toggled(on); }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("When the window is closed");
                            Select {
                                width: 220px;
                                model: [@tr("Ask"), @tr("Hide in the tray"), @tr("Quit the app")];
                                current-index <=> root.close-action;
                                selected(i) => { root.close-action-changed(i); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("Language");
                            Select {
                                width: 220px;
                                model: [@tr("Same as Windows"), "English", "Русский"];
                                current-index <=> root.language-index;
                                selected(i) => { root.language-changed(i); }
                            }
                        }
                        if root.has-reset : Divider { }
                        if root.has-reset : SettingRow {
                            title: @tr("Microphone factory settings");
                            tip: @tr("Volume, lighting, effects and the equalizer return to their defaults.");
                            Button {
                                text: @tr("Reset…");
                                kind: "danger";
                                enabled: root.device-ready;
                                clicked => { root.confirm-reset = true; }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "FIFINE Lite " + root.app-version;
                    color: Theme.text-3;
                    font-size: 11px;
                }
            }
        }
    }

    // Error toast
    if root.error-message != "" : Rectangle {
        width: Math.min(560px, parent.width - root.sidebar-width - 48px);
        height: 44px;
        x: root.sidebar-width + (parent.width - root.sidebar-width - self.width) / 2;
        // At the top: the bottom of the window is where the fields being corrected are.
        y: 16px;
        border-radius: 8px;
        background: #2a1719;
        border-width: 1px;
        border-color: #e5484d80;
        Timer {
            interval: 8s;
            running: true;
            triggered => { root.error-message = ""; }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 4px;
            spacing: 10px;
            Rectangle {
                width: 18px;
                Icon { y: (parent.height - self.height) / 2; commands: Icons.alert; stroke: Theme.red; }
            }
            Text { horizontal-stretch: 1; text: root.error-message; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
            Rectangle {
                width: 36px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 32px;
                    height: 32px;
                    border-radius: 6px;
                    background: close-ta.has-hover ? #ffffff14 : transparent;
                    Icon { x: 8px; y: 8px; width: 16px; height: 16px; commands: Icons.close; stroke: Theme.text-2; }
                    close-ta := TouchArea { mouse-cursor: pointer; clicked => { root.error-message = ""; } }
                }
            }
        }
    }

    // Reset confirmation
    if root.confirm-reset : Dialog {
        dismissed => { root.confirm-reset = false; }
        Text { text: @tr("Reset the microphone to factory settings?"); color: Theme.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
        Text {
            text: @tr("Volume, lighting, effects and the equalizer return to their defaults. This cannot be undone.");
            color: Theme.text-2;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            alignment: end;
            Button { text: @tr("Cancel"); clicked => { root.confirm-reset = false; } }
            Button { text: @tr("Reset"); kind: "danger"; clicked => { root.confirm-reset = false; root.reset-confirmed(); } }
        }
    }

    // Close prompt
    if root.close-prompt : Dialog {
        dismissed => { root.close-prompt = false; }
        Text { text: @tr("Minimize to tray or quit?"); color: Theme.text; font-size: 15px; font-weight: 600; }
        if root.light-usable && root.light-mode == 2 : Text {
            text: @tr("The lighting animation stops when the app quits.");
            color: Theme.text-2;
            font-size: 13px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            CheckBox { text: @tr("Remember my choice"); checked <=> root.close-remember; }
        }
        HorizontalLayout {
            padding-top: 8px;
            spacing: 8px;
            alignment: end;
            Button { text: @tr("Cancel"); clicked => { root.close-prompt = false; } }
            Button { text: @tr("Quit"); clicked => { root.close-choice(false, root.close-remember); } }
            Button { text: @tr("Minimize to tray"); kind: "primary"; clicked => { root.close-choice(true, root.close-remember); } }
        }
    }

    // Tooltip
    if Tip.text != "" && !root.close-prompt && !root.confirm-reset : Rectangle {
        property <length> w: Math.min(tip-measure.preferred-width, 300px) + 20px;
        property <length> below: Tip.y + Tip.anchor-height + 6px;
        x: Math.clamp(Tip.x - self.w / 2, 8px, root.width - self.w - 8px);
        y: self.below + self.height > root.height - 8px ? Tip.y - self.height - 6px : self.below;
        width: self.w;
        height: tip-layout.preferred-height;
        border-radius: 6px;
        background: #2d2f37;
        border-width: 1px;
        border-color: #454852;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000066;
        tip-measure := Text { visible: false; text: Tip.text; font-size: 12px; }
        tip-layout := VerticalLayout {
            padding: 7px;
            padding-left: 10px;
            padding-right: 10px;
            Text { text: Tip.text; color: Theme.text; font-size: 12px; wrap: word-wrap; }
        }
    }
}
